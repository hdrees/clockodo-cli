{
  "summary": "List and get customers",
  "actions": {
    "get": {
      "summary": "Show a single customer by ID (full field set).",
      "usage": "clockodo customers get <id>",
      "arguments": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "description": "Customer ID."
        }
      ],
      "options": [],
      "writes": false,
      "interactive": false,
      "requests": "GET /v3/customers/{id} (served from a fresh list cache with CACHE=1)",
      "curl": "supported",
      "data": "The customer object (full API payload).",
      "error_codes": [
        "http_404",
        "invalid_argument",
        "missing_argument"
      ]
    },
    "list": {
      "summary": "List customers, all pages. Text mode shows ID and name only.",
      "usage": "clockodo customers list [--state active|inactive|all]",
      "arguments": [],
      "options": [
        {
          "name": "--state",
          "value": "active|inactive|all",
          "default": "active",
          "description": "Filter by the active flag."
        }
      ],
      "writes": false,
      "interactive": false,
      "requests": "GET /v3/customers (paginated, cached with CACHE=1)",
      "curl": "partial",
      "notes": [
        "--curl prints page 1 only."
      ],
      "data": "Array of customer objects (full API payload).",
      "error_codes": [
        "invalid_argument"
      ]
    }
  }
}
