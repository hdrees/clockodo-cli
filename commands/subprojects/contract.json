{
  "summary": "List and get subprojects",
  "actions": {
    "get": {
      "summary": "Show a single subproject by ID (full field set).",
      "usage": "clockodo subprojects get <id>",
      "arguments": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "description": "Subproject ID."
        }
      ],
      "options": [],
      "writes": false,
      "interactive": false,
      "requests": "GET /v3/subprojects/{id} (served from a fresh list cache with CACHE=1)",
      "curl": "supported",
      "data": "The subproject object (full API payload).",
      "error_codes": [
        "http_404",
        "invalid_argument",
        "missing_argument"
      ]
    },
    "list": {
      "summary": "List subprojects, all pages. Text mode shows ID and name only.",
      "usage": "clockodo subprojects list [--state active|inactive|all]",
      "arguments": [],
      "options": [
        {
          "name": "--state",
          "value": "active|inactive|all",
          "default": "active",
          "description": "Filter by the active flag."
        }
      ],
      "writes": false,
      "interactive": false,
      "requests": "GET /v3/subprojects (paginated, cached with CACHE=1)",
      "curl": "partial",
      "notes": [
        "--curl prints page 1 only."
      ],
      "data": "Array of subproject objects (full API payload).",
      "error_codes": [
        "invalid_argument"
      ]
    }
  }
}
