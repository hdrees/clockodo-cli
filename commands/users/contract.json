{
  "summary": "List and get users, resolve the current user (me)",
  "actions": {
    "get": {
      "summary": "Show a single user by ID (full field set).",
      "usage": "clockodo users get <id>",
      "arguments": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "description": "User ID."
        }
      ],
      "options": [],
      "writes": false,
      "interactive": false,
      "requests": "GET /v3/users/{id} (served from a fresh list cache with CACHE=1)",
      "curl": "supported",
      "data": "The user object (full API payload).",
      "error_codes": [
        "http_404",
        "invalid_argument",
        "missing_argument"
      ]
    },
    "list": {
      "summary": "List users, all pages. Text mode shows ID and name only.",
      "usage": "clockodo users list [--state active|inactive|all]",
      "arguments": [],
      "options": [
        {
          "name": "--state",
          "value": "active|inactive|all",
          "default": "active",
          "description": "Filter by the active flag."
        }
      ],
      "writes": false,
      "interactive": false,
      "requests": "GET /v3/users (paginated, cached with CACHE=1)",
      "curl": "partial",
      "notes": [
        "--curl prints page 1 only."
      ],
      "data": "Array of user objects (full API payload).",
      "error_codes": [
        "invalid_argument"
      ]
    },
    "me": {
      "summary": "Show the authenticated user (resolved from the API key).",
      "usage": "clockodo users me",
      "arguments": [],
      "options": [],
      "writes": false,
      "interactive": false,
      "requests": "GET /v4/users/me (cached with CACHE=1)",
      "curl": "supported",
      "data": "The user object of the authenticated user.",
      "error_codes": []
    }
  }
}
