#!/usr/bin/env bash
# =============================================================================
# clockodo — CLI entry point.
#
# Responsibilities of this file:
#   1. Set and export the version constant (consumed by lib/env.sh).
#   2. Check that mandatory tools (curl, jq) are available.
#   3. Parse CLI arguments: <group> <action> [args...] or --help/-h.
#   4. Source the matching command script and invoke its function.
#
# Usage:
#   ./clockodo <group> <action> [args...]
#   ./clockodo --help | -h
#   ./clockodo <group> --help
# =============================================================================

# set -e   -> abort on any command failure (non-zero exit).
# set -u   -> error on use of undefined variables.
# set -o pipefail -> a pipeline fails as soon as any stage fails
#                    (otherwise only the last stage's exit code wins).
set -euo pipefail

# Current CLI version. Embedded by lib/env.sh into the
# X-Clockodo-External-Application header.
CLOCKODO_CLI_VERSION="0.1.0"
export CLOCKODO_CLI_VERSION

# resolve_script_path
#   Prints the real path of this script, following symlinks (e.g. a link in
#   ~/.local/bin), so lib/ and commands/ are found next to the real file.
#   A loop over `readlink` instead of `readlink -f`, which older macOS lacks.
#   stdout:  absolute path of the script file
resolve_script_path() {
    # BASH_SOURCE[0] is this file's path (also when sourced).
    local script_path="${BASH_SOURCE[0]}" link_target
    while [[ -L "${script_path}" ]]; do
        link_target="$(readlink "${script_path}")"
        # A relative link target is relative to the link's directory.
        if [[ "${link_target}" != /* ]]; then
            link_target="$(dirname "${script_path}")/${link_target}"
        fi
        script_path="${link_target}"
    done
    printf '%s/%s' "$(cd "$(dirname "${script_path}")" && pwd)" "$(basename "${script_path}")"
}

# Absolute path to the repo root, independent of the caller's CWD and of
# symlinks pointing to this script.
REPO_ROOT="$(dirname "$(resolve_script_path)")"

# Load help texts and shared helpers first — needed before .env is set up
# (e.g. `clockodo --help` without a configured .env).
# shellcheck source=lib/usage.sh
source "${REPO_ROOT}/lib/usage.sh"
# shellcheck source=lib/helper.sh
source "${REPO_ROOT}/lib/helper.sh"

# Strip global flags (--json, --curl, --dry-run) from "$@" before any further parsing.
# Done inline in this shell — using a process substitution would isolate the
# exports to a subshell and lose the flags.
_remaining_args=()
for _arg in "$@"; do
    case "${_arg}" in
        --json) export CLOCKODO_JSON_OUTPUT=1; continue ;;
        --curl) export CLOCKODO_CURL_OUTPUT=1; continue ;;
        --dry-run) export CLOCKODO_DRY_RUN=1; continue ;;
    esac
    _remaining_args+=("${_arg}")
done
# `${arr[@]+"${arr[@]}"}` expands to nothing when the array is empty,
# avoiding an unbound-variable error under `set -u`.
set -- ${_remaining_args[@]+"${_remaining_args[@]}"}
unset _remaining_args _arg

# --curl wins over --json: the curl command is plain text, so errors are
# reported as text too. It also wins over --dry-run: --curl sends nothing at
# all, so the dry run has nothing left to report.
if is_curl_output_mode; then
    export CLOCKODO_JSON_OUTPUT=0
    export CLOCKODO_DRY_RUN=0
fi

# Prerequisites for --curl and --dry-run (see `_print_curl_command_and_stop`
# and `_print_dry_run_and_stop` in lib/http.sh).
# Requests usually run inside `$(…)`, where stdout is captured and `exit`
# only ends the subshell. Therefore:
#   `exec 3>&1`          keeps the terminal's stdout reachable as fd 3, so
#                        the curl command can bypass the capture;
#   `trap 'exit 0' USR1` lets the subshell end the whole CLI by signalling
#                        this (main) shell — `$$` is the main shell's PID
#                        even inside subshells.
# Installed only in these modes, so a stray USR1 or a closed stdout cannot
# affect normal runs.
if is_curl_output_mode || is_dry_run_mode; then
    exec 3>&1
    trap 'exit 0' USR1
fi

# Verify required tools. Better to abort here with a clear message than to
# fail later with a cryptic "command not found".
for tool in curl jq; do
    if ! command -v "${tool}" >/dev/null 2>&1; then
        if is_json_output_mode; then
            emit_json_failure "'${tool}' is not installed." "internal_error"
        else
            echo "Error: '${tool}' is not installed." >&2
        fi
        exit 1
    fi
done

# No arguments or top-level help → print root help and exit cleanly.
if [[ $# -eq 0 ]] || is_help_arg "${1:-}"; then
    print_root_help
    exit 0
fi

# Top-level commands without action. They run before .env is loaded, so
# they work without (or with a broken) configuration:
#   describe  machine-readable command contracts, no requests at all;
#   doctor    reads the configuration itself and reports its problems;
#   upgrade   talks to git only;
#   version   talks to GitHub only.
# Each one lives in lib/<command>.sh and defines cmd_<command>.
case "$1" in
    describe|doctor|upgrade|version)
        top_level_command="$1"
        shift
        # shellcheck source=lib/http.sh
        source "${REPO_ROOT}/lib/http.sh"
        if [[ "${top_level_command}" == "doctor" ]]; then
            # shellcheck source=lib/env.sh
            source "${REPO_ROOT}/lib/env.sh"
            # shellcheck source=lib/cache.sh
            source "${REPO_ROOT}/lib/cache.sh"
        fi
        # shellcheck source=/dev/null
        source "${REPO_ROOT}/lib/${top_level_command}.sh"
        "cmd_${top_level_command}" "$@"
        exit $?
        ;;
esac

# First positional argument is the command group (e.g. "favorites").
group="$1"
shift

# Special case: `clockodo <group>` (no action) or `clockodo <group> --help`
# shows the group's help. Missing-action is treated as a help request rather
# than as a "missing argument" error because the user has no way to know
# which actions exist without seeing the help first.
if [[ $# -eq 0 ]] || ( [[ $# -eq 1 ]] && is_help_arg "$1" ); then
    print_group_help "${group}"
    exit $?
fi

# Second positional argument is the action (e.g. "list" or "start").
# `${1:-}` yields empty if $1 is unset (required because of set -u).
action="${1:-}"
# `shift || true` prevents set -e from aborting when $# is already 0.
shift || true

# Convention: one file per action under commands/<group>/<action>.sh.
command_file="${REPO_ROOT}/commands/${group}/${action}.sh"
if [[ ! -f "${command_file}" ]]; then
    if is_json_output_mode; then
        emit_json_failure "Unknown command: ${group} ${action}" "unknown_command"
    else
        echo "Unknown command: ${group} ${action}" >&2
        print_root_help
    fi
    exit 1
fi

# Load libraries in a fixed order. The order matters:
#   env.sh  → exports mandatory variables (CLOCKODO_API_USER, _API_KEY, ...).
#   http.sh → consumes those variables for auth headers.
# shellcheck source=lib/env.sh
source "${REPO_ROOT}/lib/env.sh"
# shellcheck source=lib/http.sh
source "${REPO_ROOT}/lib/http.sh"
# shellcheck source=lib/pagination.sh
source "${REPO_ROOT}/lib/pagination.sh"
# shellcheck source=lib/cache.sh
source "${REPO_ROOT}/lib/cache.sh"
# shellcheck source=lib/active_state.sh
source "${REPO_ROOT}/lib/active_state.sh"
# shellcheck source=lib/user_argument.sh
source "${REPO_ROOT}/lib/user_argument.sh"
# shellcheck source=lib/target_hours.sh
source "${REPO_ROOT}/lib/target_hours.sh"
# shellcheck source=lib/ui.sh
source "${REPO_ROOT}/lib/ui.sh"
# shellcheck source=lib/resource_actions.sh
source "${REPO_ROOT}/lib/resource_actions.sh"
# Source every other file in the group's directory (help.sh, ui.sh, ...)
# so action scripts can rely on group-local helpers. The action file itself
# is sourced last to make sure it sees all helpers in scope.
for group_file in "${REPO_ROOT}/commands/${group}"/*.sh; do
    [[ "${group_file}" == "${command_file}" ]] && continue
    [[ -f "${group_file}" ]] || continue
    # shellcheck source=/dev/null
    source "${group_file}"
done

# Command file last.
# shellcheck source=/dev/null
source "${command_file}"

# Read .env and validate mandatory variables. Done after the help paths so
# that `clockodo --help` works without a configured .env.
load_env

# Convention: each command file defines a function cmd_<group>_<action>.
# Example: commands/favorites/list.sh → cmd_favorites_list.
fn="cmd_${group}_${action}"
if ! declare -F "${fn}" >/dev/null; then
    if is_json_output_mode; then
        emit_json_failure "function ${fn} not defined in ${command_file}" "internal_error"
    else
        echo "Internal error: function ${fn} not defined in ${command_file}" >&2
    fi
    exit 1
fi

# Forward remaining arguments to the command function.
"${fn}" "$@"
