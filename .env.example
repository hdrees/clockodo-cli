CLOCKODO_API_USER=you@example.com
CLOCKODO_API_KEY=replace-me

# Optional: cache list endpoints on disk (1 = on, 0 = off; default: off).
# CACHE=1

# Optional: dump HTTP requests/responses and cache hits to stderr (default: off).
# Ignored in --json mode.
# DEBUG=1

# Optional: refuse every write request, e.g. starting or stopping the clock
# (1 = on, 0 = off; default: off). Useful when an AI agent uses the CLI.
# --dry-run still works.
# CLOCKODO_READ_ONLY=1

# Optional: identify a calling tool in the X-Clockodo-External-Application
# header ("<app>;<email>"). Default: clockodo-cli/<version>;<CLOCKODO_API_USER>.
# CLOCKODO_EXTERNAL_APPLICATION=
